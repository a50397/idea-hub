# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/

# Environment
.env
.env.local
.env.development.local
.env.test.local
# Holds REAL production secrets (filled 2026-07-29) — must never be committed.
.env.production
.env.production.local
deploy/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# IDE
# .vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Prisma
prisma/migrations/*
!prisma/migrations/.gitkeep

# Docker
docker-data/

# TLS certificates for the nginx reverse proxy — never commit key material
nginx/certs/*
!nginx/certs/.gitkeep

# Corporate CA for the backend — environment-specific, added to the deploy
# bundle by the handover engineer (see ca/README.md)
ca/*.pem

# TypeScript compiled output in frontend
frontend/src/**/*.js
frontend/src/**/*.js.map
frontend/src/**/*.d.ts
frontend/src/**/*.d.ts.map
# Keep essential Vue/Vite type declarations
!frontend/src/vue-shim.d.ts
!frontend/src/vite-env.d.ts
frontend/vite.config.js
frontend/vite.config.js.map
frontend/vite.config.d.ts
frontend/vite.config.d.ts.map

graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_root
graphify-out/.graphify_python

