# Database
# MongoDB runs with authentication + a replica set. Set root credentials here;
# docker-compose uses them for the mongod root user and to build DATABASE_URL.
# Required in BOTH modes (with or without SSO). For a shared/production deploy use
# a long, random password and URL-encode any special characters in DATABASE_URL.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# In docker-compose the backend reaches Mongo at host `mongodb`; a host-run backend
# (VS Code debug) uses `localhost` with `directConnection=true`. Include the
# credentials and `authSource=admin`, e.g.:
#   mongodb://<user>:<pass>@mongodb:27017/ideahub?replicaSet=rs0&authSource=admin
DATABASE_URL=

# Auth — SESSION_SECRET is required. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# "development" is for a HOST-RUN backend (`npm run dev`): relaxed boot guards and
# dev-skipped rate limiting. For ANY `docker compose up` set "production" — compose
# passes this value into the container, and a development value there would switch
# off rate limiting and relax the boot guards (see README Getting Started).
NODE_ENV="development"
COOKIE_SECURE="false"

# Default Admin (required on first run if no admin exists)
# Change these from defaults before running!
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Admin"

# Backend
BACKEND_PORT=3001

# Frontend
VITE_API_URL="http://localhost:3001"
# Base URL of the frontend. Used for CORS and as the post-login redirect target
# for SSO. Must match the origin the browser loads the app from.
FRONTEND_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# SSO / OIDC (corporate IAM login). Disabled by default; local login always
# remains available for the break-glass admin(s) below.
# ---------------------------------------------------------------------------
SSO_ENABLED="false"
# OIDC issuer (discovery is done against ${SSO_ISSUER_URL}/.well-known/openid-configuration)
# SSO_ISSUER_URL="https://idp.example.com"
# Client credentials issued by your IAM for this application
# SSO_CLIENT_ID="idea-hub"
# SSO_CLIENT_SECRET=""
# Redirect (callback) URI registered with the IAM — must be {BASE_URL}/api/auth/sso/callback
# SSO_REDIRECT_URI="http://localhost:3001/api/auth/sso/callback"
# Where the IAM returns the browser after RP-initiated logout ends the SSO
# session (post_logout_redirect_uri). Must be registered with the IAM. Defaults
# to ${FRONTEND_URL}/login.
# SSO_POST_LOGOUT_REDIRECT_URI="http://localhost:5173/login"
# Show the in-app logout button for SSO users (default false — the IAM owns the
# session). When true, logout also performs RP-initiated logout at the IdP.
# SSO_SHOW_LOGOUT="false"
# Requested scopes (default shown). Request only scopes registered with the
# IdP — some IdPs (incl. Keycloak 26) reject unregistered scopes with
# error=invalid_scope instead of ignoring them.
# SSO_SCOPE="openid profile email"
# Claim names, looked up in the ID token merged with the userinfo response
# (defaults shown). Namespaced names work too, e.g. SSO_ROLES_CLAIM="diam:roles".
# SSO_ROLES_CLAIM="roles"
# SSO_ORG_CLAIM="org"
# SSO_EMAIL_CLAIM="email"
# SSO_NAME_CLAIM="name"
# Map IAM role names to app roles (USER|POWER_USER|ADMIN). IAM keys are matched
# case-insensitively; the highest-privilege match wins.
# SSO_ROLE_MAP="idea-hub-admins:ADMIN,idea-hub-reviewers:POWER_USER,idea-hub-users:USER"
# Emails that may NEVER log in via SSO (comma-separated, lowercased). These stay
# local-password ("break-glass") accounts. Defaults to [ADMIN_EMAIL] when unset.
# BREAK_GLASS_EMAILS="admin@example.com"
# Hours between runs of the orphaned-SSO-user prune (deletes SSO users that have
# no session, no ideas and no idea events, last written >15 min ago). Optional;
# default 24, invalid/zero/negative values fall back to 24. Inert under NODE_ENV=test.
# SSO_PRUNE_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Mail (best-effort outbound email). Now ADMIN-MANAGED at runtime: an admin
# configures the SMTP server, from address, notification language and an optional
# subject template on the Email settings page. That config — with the SMTP password
# encrypted — is stored in the database, so there are NO SMTP_* / MAIL_* env vars.
#
# MAIL_SETTINGS_KEY is the AES-256-GCM key that encrypts BOTH stored secrets: the
# SMTP password and the Webex bot token. REQUIRED outside development: the backend
# fails fast at boot if it is missing (exactly like SESSION_SECRET). In development
# an ephemeral key is generated with a warning — but then any previously saved
# secrets become undecryptable until a stable key is provided, so set one for real
# use. Use a 32-byte value: 64 hex characters (preferred) or base64 that decodes to
# 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Local capture with mailpit (docker compose --profile mail up -d mailpit): on the
# Email settings page set host `localhost` (host-run backend) or `mailpit`
# (backend inside docker compose), port 1025, no auth, enabled on, Save, then
# read captured mail at http://localhost:8025 (see dev/MAIL-TESTING.md).
# ---------------------------------------------------------------------------
MAIL_SETTINGS_KEY=
