# Database
# MongoDB runs with authentication + a replica set. Set root credentials here;
# docker-compose uses them for the mongod root user and to build DATABASE_URL.
# Required in BOTH modes (with or without SSO). For a shared/production deploy use
# a long, random password and URL-encode any special characters in DATABASE_URL.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# In docker-compose the backend reaches Mongo at host `mongodb`; a host-run backend
# (VS Code debug) uses `localhost` with `directConnection=true`. Include the
# credentials and `authSource=admin`, e.g.:
#   mongodb://<user>:<pass>@mongodb:27017/ideahub?replicaSet=rs0&authSource=admin
DATABASE_URL=

# Auth — SESSION_SECRET is required. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV="development"
COOKIE_SECURE="false"

# Default Admin (required on first run if no admin exists)
# Change these from defaults before running!
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Admin"

# Backend
BACKEND_PORT=3001

# Frontend
VITE_API_URL="http://localhost:3001"
# Base URL of the frontend. Used for CORS and as the post-login redirect target
# for SSO. Must match the origin the browser loads the app from.
FRONTEND_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# SSO / OIDC (corporate IAM login). Disabled by default; local login always
# remains available for the break-glass admin(s) below.
# ---------------------------------------------------------------------------
SSO_ENABLED="false"
# OIDC issuer (discovery is done against ${SSO_ISSUER_URL}/.well-known/openid-configuration)
# SSO_ISSUER_URL="https://idp.example.com"
# Client credentials issued by your IAM for this application
# SSO_CLIENT_ID="idea-hub"
# SSO_CLIENT_SECRET=""
# Redirect (callback) URI registered with the IAM — must be {BASE_URL}/api/auth/sso/callback
# SSO_REDIRECT_URI="http://localhost:3001/api/auth/sso/callback"
# Where the IAM returns the browser after RP-initiated logout ends the SSO
# session (post_logout_redirect_uri). Must be registered with the IAM. Defaults
# to ${FRONTEND_URL}/login.
# SSO_POST_LOGOUT_REDIRECT_URI="http://localhost:5173/login"
# Requested scopes (default shown)
# SSO_SCOPE="openid profile email"
# ID-token claim names (defaults shown)
# SSO_ROLES_CLAIM="roles"
# SSO_ORG_CLAIM="org"
# SSO_EMAIL_CLAIM="email"
# SSO_NAME_CLAIM="name"
# Map IAM role names to app roles (USER|POWER_USER|ADMIN). IAM keys are matched
# case-insensitively; the highest-privilege match wins.
# SSO_ROLE_MAP="idea-hub-admins:ADMIN,idea-hub-reviewers:POWER_USER,idea-hub-users:USER"
# Emails that may NEVER log in via SSO (comma-separated, lowercased). These stay
# local-password ("break-glass") accounts. Defaults to [ADMIN_EMAIL] when unset.
# BREAK_GLASS_EMAILS="admin@example.com"

# ---------------------------------------------------------------------------
# Mail (best-effort outbound email). Disabled by default: sendMail() logs the
# would-send line and succeeds WITHOUT opening a socket, so nothing here is
# required for local dev. Enabling requires at least SMTP_HOST — the boot guard
# fails fast in production if MAIL_ENABLED=true without SMTP_HOST, and in
# development it downgrades to disabled with a warning. The corporate relay's
# real host / port / auth are TBD with the infra team.
# ---------------------------------------------------------------------------
MAIL_ENABLED="false"
# SMTP relay host. Required when MAIL_ENABLED=true.
# SMTP_HOST=""
# SMTP port (default 587 for STARTTLS; 465 for implicit TLS; 1025 for mailpit).
# SMTP_PORT="587"
# Implicit TLS (true = SMTPS, usually port 465). Leave false for STARTTLS on 587.
# SMTP_SECURE="false"
# Auth is optional — omit SMTP_USER for an IP-allowlisted relay. When SMTP_USER
# is set the auth object is sent (with SMTP_PASS).
# SMTP_USER=""
# SMTP_PASS=""
# From header shown to recipients (default below).
# MAIL_FROM="IdeaHub <no-reply@ideahub.local>"
#
# Local capture with mailpit (docker compose --profile mail up -d mailpit):
#   MAIL_ENABLED="true"
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"
# then read captured mail at http://localhost:8025 (see dev/MAIL-TESTING.md).
